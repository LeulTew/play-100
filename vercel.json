{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/my-games", "destination": "/index.html" },
    { "source": "/data-use", "destination": "/index.html" },
    { "source": "/friends", "destination": "/index.html" },
    { "source": "/friends/sharing", "destination": "/index.html" },
    { "source": "/friends/sharing/games", "destination": "/index.html" },
    { "source": "/friends/:uid", "destination": "/index.html" },
    { "source": "/invite", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" },
    { "source": "/__/auth/handler", "destination": "/api/auth-helper?page=handler" },
    { "source": "/__/auth/handler.js", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/handler.js" },
    { "source": "/__/auth/iframe", "destination": "/api/auth-helper?page=iframe" },
    { "source": "/__/auth/iframe.js", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/iframe.js" },
    { "source": "/__/auth/experiments.js", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/experiments.js" },
    { "source": "/my-library", "destination": "/index.html" },
    { "source": "/my-rankings", "destination": "/index.html" },
    { "source": "/discover", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/publish", "destination": "/index.html" },
    { "source": "/community", "destination": "/index.html" },
    { "source": "/creator", "destination": "/index.html" },
    { "source": "/u/:handle", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com 'sha256-UaeP8Yezthu7k4H/Jc4f1cT3S0nYbA/RBfMFWYBAFcQ='; style-src 'self' 'sha256-sZ9CEo6in5N81MStay/+6i0vx6thMpY9zmHsXb/QFAs=' 'sha256-yNMatkEIxFHj625inbs8H3k1IZESJpNsNDS241IT7/E='; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebaseinstallations.googleapis.com https://apis.google.com; frame-src 'self' https://accounts.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/social-card.png",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/social-card.svg",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/pwa/icon-192.png",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/pwa/icon-512.png",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/pwa/icon-maskable-192.png",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/pwa/icon-maskable-512.png",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/pwa/apple-touch-icon.png",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }]
    },
    {
      "source": "/__/auth/(handler|iframe|experiments)\\.js",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self' https://accounts.google.com" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/pwa-assets.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/discovery/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/videos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/discovery/catalog.v1.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/downloads/Play-100-Collection.xlsx",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Play-100-Collection.xlsx\"" }
      ]
    },
    {
      "source": "/downloads/AAA_games_u_have_to_play_list_top_100.xlsx",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"AAA_games_u_have_to_play_list_top_100.xlsx\"" }
      ]
    }
  ]
}
