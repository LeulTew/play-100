{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/data-use", "destination": "/index.html" },
    { "source": "/friends", "destination": "/index.html" },
    { "source": "/friends/sharing", "destination": "/index.html" },
    { "source": "/friends/:uid", "destination": "/index.html" },
    { "source": "/invite", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" },
    { "source": "/__/auth/handler", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/handler" },
    { "source": "/__/auth/handler.js", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/handler.js" },
    { "source": "/__/auth/iframe", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/iframe" },
    { "source": "/__/auth/iframe.js", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/iframe.js" },
    { "source": "/__/auth/experiments.js", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/experiments.js" },
    { "source": "/__/auth/links", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/links" },
    { "source": "/__/auth/links.js", "destination": "https://play100-online-48823b32.firebaseapp.com/__/auth/links.js" },
    { "source": "/my-library", "destination": "/index.html" },
    { "source": "/my-rankings", "destination": "/index.html" },
    { "source": "/discover", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/publish", "destination": "/index.html" },
    { "source": "/community", "destination": "/index.html" },
    { "source": "/creator", "destination": "/index.html" },
    { "source": "/u/:handle", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebaseinstallations.googleapis.com https://play100-online-48823b32.firebaseapp.com; frame-src 'self' https://play100-online-48823b32.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/__/auth/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'nonce-firebase-auth-helper' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self' https://accounts.google.com" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/downloads/Play-100-Collection.xlsx",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Play-100-Collection.xlsx\"" }
      ]
    },
    {
      "source": "/downloads/AAA_games_u_have_to_play_list_top_100.xlsx",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"AAA_games_u_have_to_play_list_top_100.xlsx\"" }
      ]
    }
  ]
}
