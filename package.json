{
  "name": "play-100",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "npm run format:check && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "check:csp": "tsx scripts/check-csp.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloud": "firebase emulators:exec --project demo-play100 --only auth,firestore \"vitest run --config vitest.cloud.config.ts\"",
    "validate:data": "tsx scripts/validate-data.ts",
    "import:data": "tsx scripts/import-data.ts",
    "prepare:assets": "tsx scripts/prepare-assets.ts",
    "assets:social-card": "tsx scripts/render-social-card.ts",
    "collect:discovery": "tsx scripts/collect-discovery-catalog.ts",
    "validate:discovery": "tsx scripts/collect-discovery-catalog.ts --verify"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.0.0",
    "beasties": "0.5.4",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fake-indexeddb": "^6.2.4",
    "firebase-tools": "^15.31.0",
    "globals": "^17.0.0",
    "htmlparser2": "12.0.0",
    "prettier": "3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
